# LLM providers (first match wins)
# Preferred local workaround:
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=GAMA Mentigo

# Optional alternatives:
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

AZURE_OPENAI_ENDPOINT=https://YOUR_RESOURCE.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-10-21

MAX_TOKENS_PER_RESPONSE=800
SOFT_DAILY_TOKEN_BUDGET=0

# Azure AD / Entra ID (next-auth)
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-long-random-string

# Local/dev only — never enable in production
AUTH_BYPASS=true
NEXT_PUBLIC_AUTH_BYPASS=true
